---
import { url } from "../url";
import Base from "../layouts/Base.astro";
import resume from "../data/resume.json";

type Exp = (typeof resume.experience)[number];
const groups: { company: string; location: string; roles: Exp[] }[] = [];
for (const x of resume.experience) {
  const last = groups[groups.length - 1];
  if (last && last.company.trim().toLowerCase() === x.company.trim().toLowerCase()) last.roles.push(x);
  else groups.push({ company: x.company, location: x.location, roles: [x] });
}
const dates = (a: string, b: string) => [a, b].filter((s) => s.trim()).join(" – ");
const awards = resume.certifications.map((c) => c.trim()).filter(Boolean);
---
<Base title="Experience" description={`Experience of ${resume.basics.name}: ${resume.basics.headline}`}>
  <section class="page-head">
    <h1>Experience</h1>
    <p class="muted">7+ years building production backend systems and AI platforms. <a href={url("/resume.pdf")} target="_blank" rel="noopener">Download the PDF resume</a>.</p>
  </section>

  <section class="timeline">
    {groups.map((g) => (
      <article class="company">
        <h2>{g.company} <span class="muted loc">· {g.location}</span></h2>
        {g.roles.map((r) => (
          <div class="role">
            <div class="role-head">
              <h3>{r.role}</h3>
              <span class="muted small">{dates(r.start, r.end)}</span>
            </div>
            <ul>{r.bullets.filter((t) => t.trim()).map((t) => <li>{t}</li>)}</ul>
          </div>
        ))}
      </article>
    ))}
  </section>

  <section class="section two">
    <div>
      <h2>Education</h2>
      {resume.education.map((e) => (
        <p><strong>{e.degree}</strong><br />{e.school}<br /><span class="muted small">{dates(e.start, e.end)}</span></p>
      ))}
    </div>
    {awards.length > 0 && (
      <div>
        <h2>Awards</h2>
        <ul>{awards.map((a) => <li>{a}</li>)}</ul>
      </div>
    )}
  </section>
</Base>
