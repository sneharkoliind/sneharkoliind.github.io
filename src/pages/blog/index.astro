---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, z) => z.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
---
<Base title="Blog" description="Notes on backend engineering, distributed systems and AI platforms.">
  <section class="page-head">
    <h1>Blog</h1>
    <p class="muted">What I'm learning about backend engineering, distributed systems and AI platforms.</p>
  </section>
  <ul class="post-list">
    {posts.map((p) => (
      <li>
        <a href={`/blog/${p.id}/`}>{p.data.title}</a>
        <span class="muted small">{fmt(p.data.pubDate)}</span>
        <p class="muted">{p.data.description}</p>
        {p.data.tags.length > 0 && <div class="tags">{p.data.tags.map((t) => <span class="tag">{t}</span>)}</div>}
      </li>
    ))}
  </ul>
</Base>
