---
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { url } from "../../url";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => !data.draft))
    .sort((a, z) => z.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { posts: posts.filter((p) => p.data.tags.includes(tag)) } }));
}

const { tag } = Astro.params;
const { posts } = Astro.props as { posts: CollectionEntry<"blog">[] };
---
<Base title={`Posts tagged ${tag}`} description={`Posts about ${tag}.`}>
  <section class="page-head">
    <a href={url("/")} class="back">← All posts</a>
    <h1>#{tag}</h1>
    <p class="muted">{posts.length} post{posts.length === 1 ? "" : "s"}</p>
  </section>
  <PostList posts={posts} />
</Base>
