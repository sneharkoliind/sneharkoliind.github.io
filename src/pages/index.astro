---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import { url } from "../url";
import resume from "../data/resume.json";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, z) => z.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [featured, ...rest] = posts;
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
const current = resume.experience[0];
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---
<Base description="Notes on backend systems, distributed architecture and AI platforms in production.">
  <section class="intro">
    <h1>Notes on building backend systems and AI platforms</h1>
    <p class="muted">
      I'm {resume.basics.name}, {current.role} at {current.company}. I write about distributed systems,
      Python backends and running agentic AI in production. <a href={url("/about")}>More about me →</a>
    </p>
  </section>

  {featured ? (
    <>
      <a class="featured" href={url(`/blog/${featured.id}/`)}>
        <span class="label">Latest</span>
        <h2>{featured.data.title}</h2>
        <p>{featured.data.description}</p>
        <span class="muted small">{fmt(featured.data.pubDate)} · Read →</span>
      </a>

      {rest.length > 0 && (
        <section class="section">
          <PostList posts={rest} groupByYear />
        </section>
      )}

      {tags.length > 1 && (
        <section class="section topics">
          <h2 class="year">Topics</h2>
          <div class="tags">{tags.map((t) => <a class="tag" href={url(`/tags/${t}/`)}>{t}</a>)}</div>
        </section>
      )}
    </>
  ) : (
    <p class="muted">First posts coming soon.</p>
  )}
</Base>
